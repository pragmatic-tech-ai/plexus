{
  // Shared compiler options for workspace packages/apps. Leaf tsconfigs extend
  // this (or the electron-toolkit presets) and set their own rootDir/outDir/include.
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  }
}
