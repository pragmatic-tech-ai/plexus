{
  "name": "@pragmatic-tech-ai/plexus",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Pragmatic Lab <evgen.napryaglo@gmail.com>",
  "description": "Plexus - a diagram editor built on mural, packaged as an Electron desktop app (electron-vite). Sibling app in the mural repo: consumes mural through its published package surface (no relative ../src imports, no internals), so extracting to its own repo later is a config change, not a rewrite.",
  "main": "./out/main/index.js",
  "scripts": {
    "//": "compile:mu compiles the mural UI .mu -> .mu.js via the mural CLI (Vite then bundles it). dev runs electron-vite with HMR; build produces the packaged renderer/main/preload under out/. mural is consumed from the local registry (Verdaccio); when framework source changes, republish mural and reinstall here (or `npm link` for live iteration) - the renderer bundles mural's built dist.",
    "compile:mu": "node node_modules/@pragmatic-tech-ai/mural/dist/tooling/cli.js compile src/renderer/src/plexus-icons.mu src/renderer/src/modules/diagram/diagram.module.mu src/renderer/src/modules/architecture-projects/architecture-projects.module.mu src/renderer/src/modules/project-explorer/project-explorer.module.mu src/renderer/src/modules/project-explorer/project-explorer.resources.mu src/renderer/src/modules/meta-model/meta-model.module.mu src/renderer/src/modules/meta-model/meta-model.resources.mu src/renderer/src/modules/library/library.module.mu src/renderer/src/modules/library/library.resources.mu src/renderer/src/services/panels/panels.resources.mu src/renderer/src/services/settings/settings.resources.mu src/renderer/src/services/dialogs/save-prompt.resources.mu src/renderer/src/modules/architecture-projects/services/chooser.resources.mu src/renderer/src/modules/architecture-projects/services/viewpoint-picker.resources.mu src/renderer/src/modules/diagram/diagram.resources.mu src/renderer/src/modules/diagram/layout/layout-inspector.resources.mu src/renderer/src/modules/agent-chat/agent-chat.module.mu src/renderer/src/modules/agent-chat/agent-chat.resources.mu src/renderer/src/modules/agent-chat/conversations.resources.mu src/renderer/src/modules/code-editor/code-editor.module.mu src/renderer/src/modules/code-editor/code-editor.resources.mu src/renderer/src/modules/markdown-viewer/markdown-viewer.module.mu src/renderer/src/modules/markdown-viewer/markdown-viewer.resources.mu src/renderer/src/services/document-tabs/document-tabs.resources.mu src/renderer/src/services/dock-tabs/dock-tabs.resources.mu src/renderer/src/modules/problems/problems.module.mu src/renderer/src/modules/problems/problems.resources.mu src/renderer/src/services/wiki/wiki.resources.mu src/renderer/src/window/title-bar.resources.mu src/renderer/src/modules/background-work/background-work.module.mu src/renderer/src/modules/background-work/background-work.resources.mu src/renderer/src/modules/save/save.module.mu src/renderer/src/modules/diagram-export/diagram-export.module.mu src/renderer/src/modules/diagram-export/diagram-export-preview.resources.mu src/renderer/src/app.mu",
    "build:todl-server": "node scripts/build-todl-server.mjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "dev": "npm run compile:mu && npm run build:todl-server && electron-vite dev",
    "build": "npm run compile:mu && npm run build:todl-server && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "kill": "powershell -NoProfile -Command \"Get-Process -Name node,cmd,bash -ErrorAction SilentlyContinue | Stop-Process -Force\"",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pragmatic-tech-ai/todl": "^0.33.3",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "marked": "^14.1.4",
    "pptxgenjs": "^3.12.0",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.62.1",
    "@pragmatic-tech-ai/fresco": "^0.4.1",
    "@pragmatic-tech-ai/mural": "^0.46.8",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "monaco-editor": "^0.55.1",
    "playwright": "^1.62.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
