{
  // Web side: the renderer. `mural/*` type-checks against
  // the built dist `.d.ts` (via the file:../.. dependency) — the same public
  // surface an external consumer sees. The renderer is bundled by Vite, which
  // resolves the runtime `.js` (see electron.vite.config resolve.conditions).
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.mu",
    "src/shared/**/*"
  ],
  // Renderer unit tests run under vitest (its own config), not this project
  // typecheck — the same split the node side already uses (it includes only
  // main/preload). Tests are excluded here so the app typecheck covers shipping
  // code; test type-correctness is owned by the vitest pass.
  "exclude": [
    "node_modules",
    "src/renderer/src/**/tests/**",
    "src/renderer/src/**/*.test.ts",
    "src/renderer/src/**/*.spec.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "types": ["electron-vite/node"]
  }
}
